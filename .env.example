# ---- Contentful (https://app.contentful.com) ----
# Space ID: Settings > General settings
CONTENTFUL_SPACE_ID=
# Delivery token: Settings > API keys > Add API key > "Content Delivery API - access token". Used by the website build.
CONTENTFUL_DELIVERY_TOKEN=
# Management token: avatar > Organization settings > ... > Personal access tokens. Used only by `npm run cms:setup`. Never put this on the host.
CONTENTFUL_MANAGEMENT_TOKEN=
CONTENTFUL_ENVIRONMENT=master

# ---- Site ----
# Public site URL, no trailing slash. Used for canonical links, sitemap, QR code and share cards.
NEXT_PUBLIC_SITE_URL=https://ajourneyinprovidence.com

# Formspree form endpoints (https://formspree.io). Create two forms and paste the URLs.
NEXT_PUBLIC_FORMSPREE_RSVP=
NEXT_PUBLIC_FORMSPREE_CONTACT=

# Plausible analytics domain. Leave blank to switch analytics off.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
